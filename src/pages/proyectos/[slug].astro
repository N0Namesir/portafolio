---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((p) => ({ params: { slug: p.id }, props: { proyecto: p } }));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
const { nombre, descripcion, stack, github, url } = proyecto.data;
---

<BaseLayout title={nombre} description={descripcion}>
  <a href="/proyectos" class="text-sm text-muted hover:text-fg transition-colors">← Proyectos</a>
  <h1 class="mt-4 text-3xl font-bold tracking-tight">{nombre}</h1>
  <p class="mt-3 text-muted max-w-2xl">{descripcion}</p>

  <ul class="mt-4 flex flex-wrap gap-2">
    {stack.map((tech) => (
      <li class="font-mono text-xs px-2 py-0.5 rounded border border-border text-muted">{tech}</li>
    ))}
  </ul>

  {(url || github) && (
    <div class="mt-6 flex gap-3 text-sm">
      {url && (
        <a href={url} target="_blank" rel="noopener" class="rounded-md bg-accent text-bg font-medium px-3 py-1.5 hover:opacity-90 transition-opacity">
          Ver sitio
        </a>
      )}
      {github && (
        <a href={github} target="_blank" rel="noopener" class="rounded-md border border-border px-3 py-1.5 hover:border-accent/60 transition-colors">
          GitHub
        </a>
      )}
    </div>
  )}

  <article class="prose mt-10 max-w-2xl">
    <Content />
  </article>
</BaseLayout>
