---
import { getCollection, render } from 'astro:content';
import { ArrowLeft, ExternalLink } from '@lucide/astro';
import TechIcon from '../../components/TechIcon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechChip from '../../components/TechChip.astro';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((p) => ({ params: { slug: p.id }, props: { proyecto: p } }));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
const { nombre, descripcion, stack, github, url } = proyecto.data;
const host = url ? new URL(url).host : undefined;
---

<BaseLayout title={nombre} description={descripcion}>
  <div class="pt-10 sm:pt-14">
    <a href="/proyectos" class="inline-flex items-center gap-1.5 text-haze hover:text-paper transition-colors">
      <ArrowLeft size={16} /> Proyectos
    </a>
  </div>

  <header class="mt-8 grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-8">
      <h1 class="display text-4xl sm:text-hero text-paper">{nombre}</h1>
      <p class="mt-6 text-lg sm:text-xl text-haze max-w-[52ch]">{descripcion}</p>
      {(url || github) && (
        <div class="mt-8 flex flex-wrap gap-3">
          {url && (
            <a
              href={url}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-lg bg-signal text-night font-semibold px-4 py-2.5 hover:bg-[#ffa066] transition-colors"
            >
              <ExternalLink size={16} /> {host}
            </a>
          )}
          {github && (
            <a
              href={github}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-lg border border-grid px-4 py-2.5 text-paper hover:border-signal transition-colors"
            >
              <TechIcon name="GitHub" size={16} /> Código
            </a>
          )}
        </div>
      )}
    </div>
    <aside class="lg:col-span-4 rounded-2xl border border-grid bg-chart/60 p-6 self-start">
      <p class="text-paper font-semibold">Stack</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {stack.map((tech) => <TechChip name={tech} />)}
      </ul>
    </aside>
  </header>

  <article class="prose mt-14 max-w-[64ch] pb-8">
    <Content />
  </article>
</BaseLayout>
