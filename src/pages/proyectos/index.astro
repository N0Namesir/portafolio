---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectPlate from '../../components/ProjectPlate.astro';

const proyectos = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);
---

<BaseLayout title="Proyectos" description="Proyectos de Eduardo Rivas: Muro Informativo, EPI-Aetheris y más." wide>
  <section class="pt-16 sm:pt-24 pb-12 max-w-5xl">
    <h1 class="display text-4xl sm:text-hero text-paper">Proyectos</h1>
    <p class="mt-8 text-lg sm:text-xl text-haze max-w-[48ch]">
      Trabajo personal y de equipo. Cada proyecto tiene su propia página con arquitectura, stack y mi rol.
    </p>
  </section>
  <div class="grid gap-5">
    {proyectos.map((p, i) => (
      <ProjectPlate
        slug={p.id}
        nombre={p.data.nombre}
        descripcion={p.data.descripcion}
        stack={p.data.stack}
        url={p.data.url}
        flip={i % 2 === 1}
      />
    ))}
  </div>
</BaseLayout>
