---
import * as si from 'simple-icons';

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const map: Record<string, keyof typeof si> = {
  'Astro': 'siAstro',
  'TypeScript': 'siTypescript',
  'Tailwind CSS': 'siTailwindcss',
  'Supabase': 'siSupabase',
  'Docker': 'siDocker',
  'Docker Compose': 'siDocker',
  'Node.js': 'siNodedotjs',
  'GitHub Actions': 'siGithubactions',
  'Bash': 'siGnubash',
  'PM2': 'siPm2',
  'Python': 'siPython',
  'FastAPI': 'siFastapi',
  'scikit-learn': 'siScikitlearn',
  'PostgreSQL': 'siPostgresql',
  'Leaflet': 'siLeaflet',
  'GitHub': 'siGithub',
};

const { name, size = 16, class: className } = Astro.props;
const key = map[name];
const icon = key ? (si[key] as { path: string; title: string }) : undefined;
---

{icon && (
  <svg
    role="img"
    aria-hidden="true"
    viewBox="0 0 24 24"
    width={size}
    height={size}
    fill="currentColor"
    class={className}
  >
    <path d={icon.path} />
  </svg>
)}
