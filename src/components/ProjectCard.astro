---
interface Props {
  slug: string;
  nombre: string;
  descripcion: string;
  stack: string[];
}

const { slug, nombre, descripcion, stack } = Astro.props;
---

<a
  href={`/proyectos/${slug}`}
  class="group block rounded-lg border border-border bg-surface p-6 hover:border-accent/60 transition-colors"
>
  <h3 class="text-lg font-semibold group-hover:text-accent transition-colors">{nombre}</h3>
  <p class="mt-2 text-sm text-muted leading-relaxed">{descripcion}</p>
  <ul class="mt-4 flex flex-wrap gap-2">
    {stack.map((tech) => (
      <li class="font-mono text-xs px-2 py-0.5 rounded border border-border text-muted">{tech}</li>
    ))}
  </ul>
</a>
