---
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/sobre-mi', label: 'Sobre mí' },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/contacto', label: 'Contacto' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="border-b border-border bg-bg/80 backdrop-blur sticky top-0 z-10">
  <nav class="max-w-5xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <a href="/" class="font-mono font-semibold text-accent">0V3R</a>
    <ul class="flex gap-4 sm:gap-6 text-sm">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={['hover:text-fg transition-colors', isActive(href) ? 'text-fg' : 'text-muted']}
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
