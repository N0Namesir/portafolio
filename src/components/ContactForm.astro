---
import { Send } from '@lucide/astro';

const inputClass =
  'w-full rounded-lg border border-grid bg-night px-3.5 py-2.5 text-paper placeholder:text-haze/70 focus:outline-none focus:border-signal focus:ring-2 focus:ring-signal/30 transition-shadow';
---

<form action="mailto:rivasmejiaeduardo@gmail.com" method="post" enctype="text/plain" class="space-y-5">
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="nombre" class="block text-sm text-haze mb-1.5">Nombre</label>
      <input id="nombre" name="nombre" type="text" required autocomplete="name" class={inputClass} />
    </div>
    <div>
      <label for="correo" class="block text-sm text-haze mb-1.5">Correo</label>
      <input id="correo" name="correo" type="email" required autocomplete="email" class={inputClass} />
    </div>
  </div>
  <div>
    <label for="mensaje" class="block text-sm text-haze mb-1.5">Mensaje</label>
    <textarea id="mensaje" name="mensaje" rows="6" required class={inputClass} placeholder="Cuéntame en qué puedo ayudarte."></textarea>
  </div>
  <button
    type="submit"
    class="inline-flex items-center gap-2 rounded-lg bg-signal text-night font-semibold px-5 py-2.5 hover:bg-[#ffa066] transition-colors"
  >
    <Send size={16} />
    Enviar mensaje
  </button>
</form>
